# NoteMint API environment variables

APP_NAME=NoteMint API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# Clerk authentication (Phase 2)
# Frontend API URL of your Clerk instance (no trailing slash), e.g.
# https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_ISSUER=
# Comma-separated origins permitted in the azp claim. Empty = skip check.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional JWT aud claim. Empty = skip audience verification.
CLERK_AUDIENCE=

# Neon PostgreSQL (Phase 3)
# Runtime connection string — prefer Neon's pooled connection URL.
# Use the SQLAlchemy driver prefix: postgresql+psycopg://
DATABASE_URL=
# Direct (non-pooler) connection URL used by Alembic migrations when available.
# Falls back to DATABASE_URL if empty. Both must use SSL (sslmode=require).
DIRECT_DATABASE_URL=

# Neon Object Storage (Phase 3) — S3-compatible, server-side secrets only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_STORAGE_BUCKET=notemint-files

# Document Uploads (Phase 5)
MAX_UPLOAD_SIZE_MB=20

# Background Processing & Extraction (Phase 6)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
MAX_EXTRACTION_PAGES=500
MAX_EXTRACTION_TEXT_LENGTH=10000000
EXTRACTION_LOW_TEXT_THRESHOLD=50
EXTRACTION_SCANNED_RATIO_THRESHOLD=0.8

# AI Integration & Kilo Gateway (Phase 7)
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_MODEL=kilo-auto/free
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.3
AI_MAX_CONTEXT_TOKENS=16000
AI_MAX_RETRIES=3

