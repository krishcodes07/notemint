# NoteMint frontend environment variables
# Copy to .env.local and adjust values as needed.
# Only expose NEXT_PUBLIC_* variables to the browser — never put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk authentication (https://dashboard.clerk.com)
# Run `npx -y clerk@latest init` to populate these automatically, or paste
# keys from the Clerk dashboard → API keys. Never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
